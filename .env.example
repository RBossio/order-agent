# VentureOrder - Esempio di configurazione
# Copiare in .env e modificare i valori

# Odoo
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USER=admin
ODOO_API_KEY=your-api-key-here

# PostgreSQL (VentureOrder)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ventureorder
POSTGRES_USER=ventureorder
POSTGRES_PASSWORD=changeme

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# GreenMail (test IMAP)
IMAP_HOST=localhost
IMAP_PORT=3143
IMAP_USER=test@example.com
IMAP_PASSWORD=test
