# VentureOrder - Configurazione ambiente Odoo
# Copia questo file in .env e personalizza i valori
#
# ATTENZIONE: POSTGRES_PASSWORD, ODOO_ADMIN_PASSWORD, ODOO_ADMIN_LOGIN_PASSWORD
# e ODOO_BOT_PASSWORD sono OBBLIGATORIE. `$` e `#` nelle password restano
# intatti: il generatore legge questo file da sé (Make non lo include).

# PostgreSQL
POSTGRES_DB=vo_demo
POSTGRES_USER=odoo
POSTGRES_PASSWORD=  # OBBLIGATORIO: impostare una password sicura

# Odoo
ODOO_PORT=8069
ODOO_ADMIN_PASSWORD=  # OBBLIGATORIO: master password di Odoo (admin_passwd)
ODOO_ADMIN_LOGIN_PASSWORD=  # OBBLIGATORIO: password di accesso dell'utente admin (seed/smoke)
ODOO_BOT_PASSWORD=  # OBBLIGATORIO: password per l'utente bot ventureorder-bot

# API Odoo (utente tecnico per VentureOrder)
ODOO_URL=http://localhost:8069
ODOO_DB=vo_demo
ODOO_USER=admin
ODOO_PASSWORD=  # Password utente per il connettore (non è la master password)
