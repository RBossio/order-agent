# VentureOrder - Configurazione ambiente Odoo
# Copia questo file in .env e personalizza i valori
#
# ATTENZIONE: POSTGRES_PASSWORD e ODOO_ADMIN_PASSWORD sono OBBLIGATORIE

# PostgreSQL
POSTGRES_DB=vo_demo
POSTGRES_USER=odoo
POSTGRES_PASSWORD=  # OBBLIGATORIO: impostare una password sicura

# Odoo
ODOO_PORT=8069
ODOO_ADMIN_PASSWORD=  # OBBLIGATORIO: master password di Odoo

# API Odoo (utente tecnico per VentureOrder)
ODOO_URL=http://localhost:8069
ODOO_DB=vo_demo
ODOO_USER=admin
ODOO_PASSWORD=  # Password utente admin
