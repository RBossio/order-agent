# VentureOrder - Configurazione ambiente Odoo
# Copia questo file in .env e personalizza i valori

# PostgreSQL
POSTGRES_DB=vo_demo
POSTGRES_USER=odoo
POSTGRES_PASSWORD=changeme_in_production

# Odoo
ODOO_PORT=8069
ODOO_ADMIN_PASSWORD=changeme_admin_password

# API Odoo (utente tecnico per VentureOrder)
ODOO_URL=http://localhost:8069
ODOO_DB=vo_demo
ODOO_USER=ventureorder-bot
ODOO_API_KEY=changeme_api_key
